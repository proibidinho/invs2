---
###############################################################################
# TOKEN
###############################################################################

- name: Generate access token
  ansible.builtin.uri:
    url: "https://{{ url_aap }}/api/controller/v2/tokens/"
    method: POST
    user: "{{ username }}"
    password: "{{ password }}"
    force_basic_auth: true
    return_content: true
    validate_certs: false
    status_code: 201
  register: access_token

###############################################################################
# JOBS
###############################################################################

- name: Get latest 30 jobs
  ansible.builtin.uri:
    url: "https://{{ url_aap }}/api/controller/v2/jobs/?page_size=30&order_by=-finished"
    method: GET
    headers:
      Authorization: "Bearer {{ access_token.json.token }}"
    validate_certs: false
    return_content: true
    status_code: 200
    timeout: 120
  register: jobs_response

###############################################################################
# SAVE RAW PAYLOAD
###############################################################################

- name: Save raw jobs response
  copy:
    content: "{{ jobs_response.json | to_nice_json }}"
    dest: "/tmp/jobs_latest_30.json"

###############################################################################
# BASIC METRICS
###############################################################################

- name: Total jobs returned
  set_fact:
    total_jobs: "{{ jobs_response.json.results | length }}"

- name: Successful jobs
  set_fact:
    successful_jobs: "{{ jobs_response.json.results | selectattr('status', 'equalto', 'successful') | list | length }}"

- name: Failed jobs
  set_fact:
    failed_jobs: "{{ jobs_response.json.results | selectattr('status', 'equalto', 'failed') | list | length }}"

- name: Running jobs
  set_fact:
    running_jobs: "{{ jobs_response.json.results | selectattr('status', 'equalto', 'running') | list | length }}"

- name: Cancelled jobs
  set_fact:
    cancelled_jobs: "{{ jobs_response.json.results | selectattr('status', 'equalto', 'canceled') | list | length }}"

###############################################################################
# ELAPSED
###############################################################################

- name: Average elapsed
  set_fact:
    avg_elapsed: "{{ ((jobs_response.json.results | map(attribute='elapsed') | map('float') | list | sum) / (jobs_response.json.results | length)) | float }}"

- name: Longest job
  set_fact:
    max_elapsed: "{{ jobs_response.json.results | map(attribute='elapsed') | map('float') | max }}"

###############################################################################
# TOP TEMPLATES
###############################################################################

- name: Extract template names
  set_fact:
    template_names: >-
      {{
        jobs_response.json.results
        | map(attribute='summary_fields')
        | map(attribute='job_template')
        | map(attribute='name')
        | list
      }}

###############################################################################
# DASHBOARD PREVIEW
###############################################################################

- name: Dashboard summary
  debug:
    msg:
      total_jobs: "{{ total_jobs }}"
      successful_jobs: "{{ successful_jobs }}"
      failed_jobs: "{{ failed_jobs }}"
      running_jobs: "{{ running_jobs }}"
      cancelled_jobs: "{{ cancelled_jobs }}"
      avg_elapsed_seconds: "{{ avg_elapsed }}"
      max_elapsed_seconds: "{{ max_elapsed }}"

###############################################################################
# FIND A FINISHED JOB
###############################################################################

- name: Select first completed job
  set_fact:
    completed_job: >-
      {{
        (
          jobs_response.json.results
          | selectattr('status', 'in', ['successful', 'failed', 'error', 'canceled'])
          | list
        )[0]
      }}

- name: Show selected job
  debug:
    msg:
      id: "{{ completed_job.id }}"
      name: "{{ completed_job.name }}"
      status: "{{ completed_job.status }}"

###############################################################################
# JOB HOST SUMMARIES
###############################################################################

- name: Get host summaries
  ansible.builtin.uri:
    url: "https://{{ url_aap }}/api/controller/v2/jobs/{{ completed_job.id }}/job_host_summaries/"
    method: GET
    headers:
      Authorization: "Bearer {{ access_token.json.token }}"
    validate_certs: false
    return_content: true
    status_code: 200
    timeout: 120
  register: host_summaries

- name: Save host summaries
  copy:
    content: "{{ host_summaries.json | to_nice_json }}"
    dest: "/tmp/job_host_summaries.json"

- name: Host summaries count
  debug:
    msg:
      total_hosts: "{{ host_summaries.json.count }}"

- name: Show first host summary
  debug:
    var: host_summaries.json.results[0]

###############################################################################
# SHOW FIRST JOB
###############################################################################

- name: Example first job
  debug:
    var: jobs_response.json.results[0]

###############################################################################
# SHOW TEMPLATES
###############################################################################

- name: Templates found
  debug:
    var: template_names
